{
  "name": "golem-kit",
  "version": "0.2.2",
  "description": "Starter kit and local CLI for Golem applications.",
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./eslint": "./src/eslint.mjs",
    "./operations": "./src/operations.ts",
    "./server": "./src/backend/index.ts",
    "./*": "./*"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "assets/golem-mascot.png",
    "docs/local-cli.md",
    "docs/architecture.md",
    "docs/builder.md",
    "docs/app-backend.md",
    "docs/knowledge.md",
    "docs/agents.md",
    "docs/source-development.md",
    "golem.config.ts",
    "index.html",
    "src",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonylampada/golem.git"
  },
  "bugs": {
    "url": "https://github.com/tonylampada/golem/issues"
  },
  "homepage": "https://github.com/tonylampada/golem#readme",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": "10.28.2"
  },
  "bin": {
    "golem-kit": "src/cli.ts"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "8.0.6",
    "@types/node": "22.20.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "croner": "10.0.1",
    "eslint": "10.11.0",
    "golem-ui": "0.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.1.9",
    "zod": "4.6.5"
  }
}
